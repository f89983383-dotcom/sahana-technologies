# Copy this file to .env and add real values (never commit .env).
#
# OPTIONAL. The image finder defaults to Wikimedia Commons (free-licensed,
# no API key required). If you prefer additional sources, add a Bing Image
# Search key and the tool will use it as a secondary discovery source.
IMAGE_SEARCH_API_KEY=
# Comma-separated list of providers to use, e.g. "wikimedia,bing".
IMAGE_SEARCH_PROVIDERS=wikimedia